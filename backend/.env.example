# Tawala backend environment template
# Copy to backend/.env (or .env.local) and fill real secrets.
# CI and pytest load this file for required Settings keys — keep it complete.
# pydantic-settings reads env names case-insensitively (FRONTEND_URL → frontend_url).
# Never commit real secrets. Defaults below are for local development only.

# --- App ---
APP_NAME=Tawala
APP_VERSION=0.0.1
ENVIRONMENT=development

# --- Database ---
DATABASE_NAME=tawala
DATABASE_USER=tawala
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_PASSWORD=change-me

# --- Security / JWT (tenant staff) ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ISSUER=tawala
AUDIENCE=tawala
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PIN_TOKEN_EXPIRE_HOURS=8

# --- Bootstrap admin (prestart / local only) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Management (optional; defaults shown) ---
ADMIN_ROUTE=false
RBAC_CACHE_TTL_SEC=120
AUDIT_ENABLED=true

# --- Ecosystem auth M1: hard-session JWT verify (Keycloak → NetHubKe → Tawala) ---
# Keep false until issuer + JWKS are configured. Legacy staff login unchanged when false.
AUTH_HARD_SESSION_V2=false
AUTH_HARD_ISSUER=
AUTH_HARD_AUDIENCE=tawala-api
AUTH_HARD_JWKS_URL=
AUTH_HARD_JWKS_CACHE_TTL_SEC=600
AUTH_HARD_LEEWAY_SEC=10

# --- Tenant RBAC matrix from DB (phase 1 dual-read). Default false = in-code matrix. ---
AUTH_RBAC_FROM_DB=false

# --- Platform operator plane ---
# Temporary hard-delete of organizations (test cleanup only). Default false.
# Enable only during a controlled window; see docs/platform/cleanup-window-runbook.md
PLATFORM_ORG_HARD_DELETE=false

# Platform login email MFA (when MFA routes are deployed — issue #298).
# Password login returns a challenge; access token only after verify-code.
PLATFORM_MFA_CODE_TTL_SEC=600
PLATFORM_MFA_MAX_ATTEMPTS=5
PLATFORM_MFA_RESEND_COOLDOWN_SEC=60

# --- Soft-delete archive pipeline (keep false until object storage + email + purge are live) ---
ARCHIVE_ENABLED=false
ARCHIVE_SIGNED_URL_TTL_DAYS=7
DATA_RETENTION_FALLBACK_MONTHS=6

# --- HTTP / CORS ---
RESOURCE_SERVER=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=re_change_me
EMAIL_FROM_SECURITY=NetHub Security <security@nethub.co.ke>
EMAIL_FROM_BILLING=NetHub Billing <billing@nethub.co.ke>
EMAIL_FROM_SUPPORT=NetHub Support <support@nethub.co.ke>
EMAIL_FROM_TAWALA=Tawala System <tawala@nethub.co.ke>
EMAIL_FROM_MARKETING=NetHub Updates <newsletter@nethub.co.ke>

# --- Frontend origin (required) ---
# Used in password-reset, onboarding setup, trial, and platform MFA emails.
FRONTEND_URL=http://localhost:3000

# --- Redis (sessions, cache, MFA challenges, rate limits) ---
REDIS_URL=redis://localhost:6379/0
