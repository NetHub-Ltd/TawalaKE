# Tawala frontend environment template
# Copy to frontend/.env.local (preferred for Next.js) and fill real values.
# Never commit secrets. Only NEXT_PUBLIC_* is exposed to the browser.

# --- Next.js / Auth.js ---
# Used to encrypt session cookies (server-only). Generate a long random string.
AUTH_SECRET=change-me-to-a-long-random-string
# Legacy alias still accepted by some helpers:
# NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Public site URL (optional; Auth.js trustHost is enabled in src/auth.ts)
# NEXTAUTH_URL=http://localhost:3000

# --- Backend API (server-side BFF / route handlers / Auth.js credentials) ---
# Absolute origin of the FastAPI backend, no trailing slash required.
# Used by: src/auth.ts, app/api/v1/** proxies, lib/api/backend.ts
BACKEND_URL=http://localhost:8000

# --- Browser-visible API base ---
# Used by axiosClient and platform operator login (lib/platform/auth.ts).
# For local dev this is often the backend URL if the browser talks to FastAPI
# directly (CORS must allow the frontend origin).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Client fetcher base (lib/api/fetcher.ts). Prefer same-origin /api when using
# Next route handlers as a BFF; otherwise point at the backend.
NEXT_PUBLIC_FETCHER_URL=http://localhost:3000/api

# --- Notes ---
# Platform console: /platform/login (operator MFA + orgs UI when those PRs are deployed).
# Store staff login: /login (NextAuth credentials → BACKEND_URL /auth/login).
# Hard-delete of orgs is controlled on the backend only (PLATFORM_ORG_HARD_DELETE).
